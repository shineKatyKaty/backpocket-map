# コピーして frontend/.env.local を作る（.env.* は .gitignore 済み）

# Google Maps JavaScript API キー（localhost 制限付きのブラウザ用キー）
VITE_GOOGLE_MAPS_API_KEY=your-browser-api-key

# AdvancedMarker 用の Map ID。未設定なら Google の DEMO_MAP_ID を使う。
# 本番は Cloud Console の「地図スタイル」で発行した Map ID を入れる。
VITE_GOOGLE_MAPS_MAP_ID=

# Worker API のベースURL。未設定ならバンドルされたサンプルデータで動く。
# ローカル: http://127.0.0.1:8787  本番: https://backpocket-map-api.<account>.workers.dev
VITE_API_BASE=
